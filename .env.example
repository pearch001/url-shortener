# Environment Variables for URL Shortener Service
# Copy this file to .env and customize for your environment

# ==========================================
# Spring Configuration
# ==========================================

# Active Spring Profile (default, postgres, test, prod)
SPRING_PROFILES_ACTIVE=postgres

# ==========================================
# Database Configuration - PostgreSQL
# ==========================================

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/urlshortener
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ==========================================
# Database Configuration - H2 (Development)
# ==========================================

# Uncomment for H2 in-memory database
# SPRING_DATASOURCE_URL=jdbc:h2:mem:urlshortenerdb
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver

# ==========================================
# JPA/Hibernate Configuration
# ==========================================

SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# ==========================================
# Application Configuration
# ==========================================

# Base URL for shortened links (without trailing slash)
URL_SHORTENER_BASE_URL=http://localhost:8080

# Code generation settings
URL_SHORTENER_CODE_LENGTH=7
URL_SHORTENER_CODE_MAX_RETRIES=5
URL_SHORTENER_CODE_STRATEGY=random

# URL expiration settings
URL_SHORTENER_DEFAULT_EXPIRATION_DAYS=365
URL_SHORTENER_CLEANUP_ENABLED=true
URL_SHORTENER_CLEANUP_CRON=0 0 2 * * *

# ==========================================
# Rate Limiting Configuration
# ==========================================

URL_SHORTENER_RATE_LIMIT_ENABLED=true
URL_SHORTENER_RATE_LIMIT_CAPACITY=10
URL_SHORTENER_RATE_LIMIT_REFILL_TOKENS=10
URL_SHORTENER_RATE_LIMIT_REFILL_PERIOD_MINUTES=1

# ==========================================
# Server Configuration
# ==========================================

SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/
SERVER_COMPRESSION_ENABLED=true

# ==========================================
# Logging Configuration
# ==========================================

# Root logging level
LOGGING_LEVEL_ROOT=INFO

# Application logging
LOGGING_LEVEL_COM_URLSHORTENER=INFO

# Spring framework logging
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_BOOT=INFO

# Hibernate logging
LOGGING_LEVEL_ORG_HIBERNATE_SQL=DEBUG
LOGGING_LEVEL_ORG_HIBERNATE_TYPE_DESCRIPTOR_SQL_BASICBINDER=TRACE

# Database connection pool logging
LOGGING_LEVEL_COM_ZAXXER_HIKARI=INFO

# File logging (optional)
# LOGGING_FILE_NAME=logs/url-shortener.log
# LOGGING_FILE_MAX_SIZE=10MB
# LOGGING_FILE_MAX_HISTORY=30

# ==========================================
# Actuator Configuration
# ==========================================

MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true

# ==========================================
# JVM Configuration
# ==========================================

# Heap size
JAVA_OPTS_MEMORY=-Xms512m -Xmx1024m

# Garbage collection
JAVA_OPTS_GC=-XX:+UseG1GC -XX:MaxGCPauseMillis=200

# Performance tuning
JAVA_OPTS_PERFORMANCE=-XX:+DisableExplicitGC -Djava.security.egd=file:/dev/./urandom

# Container support
JAVA_OPTS_CONTAINER=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

# Complete JAVA_OPTS
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+DisableExplicitGC -Djava.security.egd=file:/dev/./urandom -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

# ==========================================
# Security Configuration (if enabled)
# ==========================================

# CORS settings
# SPRING_WEB_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
# SPRING_WEB_CORS_ALLOWED_METHODS=GET,POST,DELETE,PATCH
# SPRING_WEB_CORS_ALLOW_CREDENTIALS=true

# ==========================================
# PostgreSQL Docker Configuration
# ==========================================

POSTGRES_DB=urlshortener
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB

# ==========================================
# pgAdmin Configuration (Optional)
# ==========================================

PGADMIN_DEFAULT_EMAIL=admin@urlshortener.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ==========================================
# Development/Production Flags
# ==========================================

# Set to 'true' in production
PRODUCTION_MODE=false

# Enable debug mode
DEBUG_MODE=false

# ==========================================
# Monitoring & Observability
# ==========================================

# Application name for metrics
SPRING_APPLICATION_NAME=url-shortener

# Metrics tags
MANAGEMENT_METRICS_TAGS_APPLICATION=url-shortener
MANAGEMENT_METRICS_TAGS_ENVIRONMENT=development

# ==========================================
# Notes
# ==========================================

# 1. Never commit .env files to version control
# 2. Use strong passwords in production
# 3. Adjust JVM settings based on available resources
# 4. Enable SSL/TLS in production
# 5. Configure proper CORS settings for production
# 6. Use environment-specific profiles (dev, staging, prod)
